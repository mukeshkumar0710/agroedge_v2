# ==============================================================================
# AgroEdge MERN Stack Environment Configuration
# ==============================================================================

# Application Environment (development | production | test)
NODE_ENV=development
APP_ENV=development

# Network Binding Settings
HOST=0.0.0.0
PORT=8000
CLIENT_PORT=5173

# Cross-Origin Resource Sharing (CORS)
CORS_ORIGINS=*

# ==============================================================================
# MongoDB Database Configuration (MongoDB Atlas Cloud URI or Local)
# ==============================================================================
# For MongoDB Atlas Cloud:
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas details.
# Example: mongodb+srv://admin:StrongPassword123@cluster0.abcde.mongodb.net/agroedge_db?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/agroedge_db?retryWrites=true&w=majority

# For Local MongoDB (Alternative):
# MONGODB_URI=mongodb://127.0.0.1:27017/agroedge_db

MONGODB_DB_NAME=agroedge_db
MONGODB_COLLECTION_NAME=incidents
MONGODB_CONNECT_TIMEOUT_MS=8000

# ==============================================================================
# Geospatial & Telemetry Defaults
# ==============================================================================
# Geospatial Center Coordinates (WGS84 Latitude & Longitude)
DEFAULT_CENTER_LAT=20.5937
DEFAULT_CENTER_LNG=78.9629

# Maximum Allowable Upload Payload (15MB in bytes)
MAX_IMAGE_SIZE_BYTES=15728640

# Pre-seed Historical Sample Telemetry if MongoDB collection is empty
SEED_SAMPLE_DATA=true
