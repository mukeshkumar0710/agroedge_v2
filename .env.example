# ==============================================================================
# AgroEdge Environment Configuration Template
# Copy this file to .env and adjust variables for your target environment.
# ==============================================================================

# Application Environment (production, staging, development, testing)
APP_ENV=production

# Network Binding Settings
HOST=0.0.0.0
PORT=8000
WORKERS=2
RELOAD=false
LOG_LEVEL=info

# Cross-Origin Resource Sharing (CORS)
# Provide "*" for unrestricted access or comma-separated allowed origins:
# Example: CORS_ORIGINS=https://agroedge.example.com,https://command.example.com
CORS_ORIGINS=*

# Geospatial Center Coordinates (WGS84 Latitude & Longitude)
# Default: Central India
DEFAULT_CENTER_LAT=20.5937
DEFAULT_CENTER_LNG=78.9629

# Maximum Allowable Upload Payload (Bytes)
# Default: 15MB (15728640 bytes)
MAX_IMAGE_SIZE_BYTES=15728640

# Docker Compose Port Bindings
HTTP_PORT=80
HTTPS_PORT=443
DIRECT_PORT=8000
