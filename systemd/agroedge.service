[Unit]
Description=AgroEdge Telemetry PWA & Geospatial Command Hub
After=network.target

[Service]
Type=simple
User=agroedge
Group=agroedge
WorkingDirectory=/opt/agroedge
EnvironmentFile=/opt/agroedge/.env
ExecStart=/opt/agroedge/venv/bin/uvicorn backend.app:app --host 0.0.0.0 --port 8000 --workers 4 --proxy-headers --forwarded-allow-ips "*"
Restart=always
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=30s
PrivateTmp=true

# Security Hardening Directives
ProtectSystem=full
ProtectHome=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
